{
  "name": "db-ui-lib",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "ng build db-ui-kit",
    "watch": "ng build db-ui-kit --watch --configuration development",
    "test": "ng test db-ui-kit",
    "publish:lib": "npm run build && cd dist/db-ui-kit && npm publish"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.23",
    "@angular/compiler": "~21.2.23",
    "@angular/core": "~21.2.23",
    "@angular/forms": "~21.2.23",
    "@angular/platform-browser": "~21.2.23",
    "flatpickr": "^4.6.13",
    "quill": "^2.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.23",
    "@angular/cli": "~21.2.23",
    "@angular/compiler-cli": "~21.2.23",
    "jsdom": "^27.4.0",
    "ng-packagr": "^21.2.7",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  }
}
